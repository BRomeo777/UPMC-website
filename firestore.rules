rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /upmc-site/{document=**} {
      allow read, write: if true;
    }
    match /upmc-site-images/{document=**} {
      allow read, write: if true;
    }
    match /upmc-analytics/{document=**} {
      allow read, write: if true;
    }
    match /appointments/{document=**} {
      allow read, write: if true;
    }
  }
}
